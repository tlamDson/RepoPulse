# Copy to .env to run locally. Do not commit .env.
# On GitHub Actions these values live in repository secrets.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# Optional: /sql/1.0/warehouses/<id>; if missing, repopulse.probe finds it through the warehouses API.
DATABRICKS_HTTP_PATH=
# Optional, not a secret: base schema of the `databricks` target; empty/missing = repopulse_probe.
# The dbt-databricks.yml workflow sets repopulse_dbt (docs/dbt-databricks.md).
DBT_DATABRICKS_SCHEMA=
MOTHERDUCK_TOKEN=
# Optional, not a secret: MotherDuck database of the `motherduck` target; empty/missing = repopulse.
# The PR smoke step (pipeline.yml) sets repopulse_smoke.
MOTHERDUCK_DATABASE=
# Snowflake port (PR 13, docs/snowflake-port.md): SERVICE user with key-pair login,
# SNOWFLAKE_PRIVATE_KEY is a PKCS#8 PEM without a passphrase. Only used in the snowflake-port.yml workflow.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
# Salt for PII hashing at silver (repopulse.spark.job). Required; there is no default value.
PII_HASH_SALT=
# Daily report email of the orchestrator (local machine, not a GitHub secret). Set it as a Windows
# environment variable (setx); the script does not read the .env file. App password: Google Account >
# Security > App passwords (2-Step Verification must be on). If missing, only logs/daily-<date>.md is written.
REPOPULSE_SMTP_USER=
REPOPULSE_SMTP_APP_PASSWORD=
# Optional: recipient, defaults to REPOPULSE_SMTP_USER.
REPOPULSE_REPORT_TO=
# SQL agent (python -m repopulse.sql_agent, docs/sql-agent.md): OpenAI-compatible LLM API.
# Local environment variables; the module does not read the .env file. Empty = default
# http://127.0.0.1:8080/v1 (llama-server); the --base-url / --model flags override these variables.
REPOPULSE_LLM_BASE_URL=
# Model name sent in the request (required unless --model is passed).
REPOPULSE_LLM_MODEL=
# Optional: only when the server demands a key (sent as Authorization: Bearer). Never printed or logged.
REPOPULSE_LLM_API_KEY=
