# Sao chép thành .env để chạy local. Không commit .env.
# Trên GitHub Actions các giá trị này nằm trong repository secrets.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# Tuỳ chọn: /sql/1.0/warehouses/<id>; thiếu thì repopulse.probe tự tìm qua API warehouses.
DATABRICKS_HTTP_PATH=
# Tuỳ chọn, không phải secret: schema gốc của target `databricks`; rỗng/thiếu = repopulse_probe.
# Workflow dbt-databricks.yml đặt repopulse_dbt (docs/dbt-databricks.md).
DBT_DATABRICKS_SCHEMA=
MOTHERDUCK_TOKEN=
# Tuỳ chọn, không phải secret: database MotherDuck của target `motherduck`; rỗng/thiếu = repopulse.
# Bước smoke của PR (pipeline.yml) đặt repopulse_smoke.
MOTHERDUCK_DATABASE=
# Port Snowflake (PR 13, docs/snowflake-port.md): user SERVICE đăng nhập key-pair,
# SNOWFLAKE_PRIVATE_KEY là PEM PKCS#8 không mật khẩu. Chỉ dùng trong workflow snowflake-port.yml.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
# Salt băm PII ở silver (repopulse.spark.job). Bắt buộc; không có giá trị mặc định.
PII_HASH_SALT=
# Email báo cáo ngày của orchestrator (máy local, không phải GitHub secret). Đặt làm biến môi
# trường của Windows (setx), script không đọc file .env. App password: Google Account > Security >
# App passwords (cần bật 2-Step Verification). Thiếu thì chỉ ghi logs/daily-<ngày>.md.
REPOPULSE_SMTP_USER=
REPOPULSE_SMTP_APP_PASSWORD=
# Tuỳ chọn: người nhận, mặc định là REPOPULSE_SMTP_USER.
REPOPULSE_REPORT_TO=
# SQL agent (python -m repopulse.sql_agent, docs/sql-agent.md): API OpenAI-compatible của LLM.
# Biến môi trường local, module không đọc file .env. Rỗng = mặc định http://127.0.0.1:8080/v1
# (llama-server); cờ --base-url / --model đè các biến này.
REPOPULSE_LLM_BASE_URL=
# Tên model gửi trong request (bắt buộc nếu không truyền --model).
REPOPULSE_LLM_MODEL=
# Tuỳ chọn: chỉ khi server đòi key (gửi Authorization: Bearer). Không bao giờ được in hay ghi log.
REPOPULSE_LLM_API_KEY=
