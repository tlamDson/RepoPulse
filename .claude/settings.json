{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(python -m pytest*)",
      "Bash(python -m ruff *)",
      "Bash(python -m pip install -e *)",
      "Bash(python scripts/*)",
      "Bash(python benchmarks/*)",
      "Bash(pip install -e *)",
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(pre-commit *)",
      "Bash(dbt *)",
      "Bash(databricks *)",
      "Bash(duckdb *)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(curl http://localhost*)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl http://127.0.0.1*)",
      "Bash(curl -s http://127.0.0.1*)"
    ],
    "ask": [
      "Bash(gh secret *)",
      "Bash(gh repo delete*)",
      "Bash(databricks bundle destroy*)",
      "Bash(snowsql *)",
      "Bash(dbt * --target snowflake*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin develop)",
      "Bash(git push origin develop *)",
      "Bash(git push origin HEAD:develop*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh pr merge * --admin*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python -c \"import json,subprocess,sys;d=json.load(sys.stdin);f=(d.get('tool_input') or {}).get('file_path','');f.endswith('.py') and subprocess.run([sys.executable,'-m','ruff','format','-q',f],capture_output=True)\" 2>/dev/null || true",
            "statusMessage": "Formatting with ruff"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_permission.py\" 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "if ($env:REPOPULSE_TASK) { exit 0 }; (New-Object Media.SoundPlayer 'C:\\Windows\\Media\\Windows Exclamation.wav').PlaySync()",
            "async": true,
            "timeout": 10,
            "statusMessage": "permission chime"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_permission.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "if ($env:REPOPULSE_TASK) { exit 0 }; (New-Object Media.SoundPlayer 'C:\\Windows\\Media\\chimes.wav').PlaySync()",
            "async": true,
            "timeout": 10,
            "statusMessage": "done chime"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "if ($env:REPOPULSE_TASK) { exit 0 }; (New-Object Media.SoundPlayer 'C:\\Windows\\Media\\Windows Exclamation.wav').PlaySync()",
            "async": true,
            "timeout": 10,
            "statusMessage": "needs-input chime"
          }
        ]
      }
    ]
  }
}
